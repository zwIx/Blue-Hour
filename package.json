{
  "name": "blue-hour",
  "version": "0.1.0",
  "description": "Blue Hour local music player",
  "main": "main.cjs",
  "author": "ZWLX",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build": "electron-builder --mac dir --arm64",
    "test:app": "node tests/smoke.cjs && node tests/lifecycle.cjs"
  },
  "build": {
    "appId": "space.zwlx.bluehour",
    "productName": "Blue Hour",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**",
      "src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "bin/**",
          "managed/cpython-3.12.16-macos-aarch64-none/**",
          "packages/**",
          "worker.py",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Used only when requesting permission to list your audio output devices."
      },
      "icon": "src/assets/icon.png"
    }
  },
  "dependencies": {
    "music-metadata": "^12.3.5"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "deno": "^2.9.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "lucide": "^1.70.0",
    "playwright": "^1.65.0"
  }
}